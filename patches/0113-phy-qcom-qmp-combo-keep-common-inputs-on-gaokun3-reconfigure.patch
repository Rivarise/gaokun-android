From: Rivarise <197336913+Rivarise@users.noreply.github.com>
Subject: [PATCH] phy: qcom-qmp-combo: retain Gaokun3 inputs on Type-C changes

On Gaokun3's secondary combo PHY, gating the shared supplies and input
clocks during live orientation/mode changes can leave USB devices unable
to enumerate until reboot. Holding only PIPE during these changes was
insufficient in an empty-port boot comparison; holding the common inputs
allowed both ECHO-B orientations and repeated hotplug to enumerate.

Keep the already-owned common inputs across forced reconfiguration on
this board/PHY only, while still asserting resets and programming the
new orientation/mode. Normal consumer init/exit retains the existing
resource ownership and releases the inputs, without extra permanent refs.

Propagate reconfiguration errors, retain a dirty flag so an unchanged
request retries after failure, and keep failed recovery away from active
DP. Also leave PIPE cleanup to the common owner when USB init times out.

Tested on Android 16 RC2 (build1792913333), kernel7.2.9 plus this project's
RC2 recipe: ECHO-B both orientations/empty boot/reinsert/pause-resume,
P40 both orientations at10000Mb/s UAS with bounded reads, and ECHO-B after
s2idle. Native resource references remain balanced; no permanent hold
module was loaded. Physical DP display and long standby power untested.
See docs/contrib/rc2-usb-hotplug-20261028.md for controls and limits.

---
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -19,6 +19,7 @@
 #include <linux/regulator/consumer.h>
 #include <linux/reset.h>
 #include <linux/slab.h>
+#include <linux/string.h>
 #include <linux/usb/typec.h>
 #include <linux/usb/typec_dp.h>
 #include <linux/usb/typec_mux.h>
@@ -2314,6 +2315,7 @@
 	enum typec_orientation orientation;
 
 	struct typec_mux_dev *mux;
+	bool typec_reconfigure_failed;
 };
 
 static void qmp_v3_dp_aux_init(struct qmp_combo *qmp);
@@ -3627,21 +3629,36 @@
 	return ret;
 }
 
+/*
+ * Keep common inputs active while resetting and reprogramming Gaokun3's
+ * secondary PHY during a live Type-C change. The ordinary init/exit
+ * paths still own and release the resources, including PIPE for DP-only USB2.
+ */
+static bool qmp_combo_keep_inputs_on_reconfigure(struct qmp_combo *qmp)
+{
+	return qmp->init_count &&
+		of_machine_is_compatible("huawei,gaokun3") &&
+		!strcmp(dev_name(qmp->dev), "8903000.phy");
+}
+
 static int qmp_combo_com_init(struct qmp_combo *qmp, bool force)
 {
 	const struct qmp_phy_cfg *cfg = qmp->cfg;
 	void __iomem *com = qmp->com;
 	void __iomem *pcs_aon = qmp->pcs_aon;
+	bool keep_inputs = force && qmp_combo_keep_inputs_on_reconfigure(qmp);
 	int ret;
 	u32 val;
 
 	if (!force && qmp->init_count++)
 		return 0;
 
-	ret = regulator_bulk_enable(cfg->num_vregs, qmp->vregs);
-	if (ret) {
-		dev_err(qmp->dev, "failed to enable regulators, err=%d\n", ret);
-		goto err_decrement_count;
+	if (!keep_inputs) {
+		ret = regulator_bulk_enable(cfg->num_vregs, qmp->vregs);
+		if (ret) {
+			dev_err(qmp->dev, "failed to enable regulators, err=%d\n", ret);
+			goto err_decrement_count;
+		}
 	}
 
 	ret = reset_control_bulk_assert(cfg->num_resets, qmp->resets);
@@ -3656,15 +3673,17 @@
 		goto err_disable_regulators;
 	}
 
-	ret = clk_bulk_prepare_enable(qmp->num_clks, qmp->clks);
-	if (ret)
-		goto err_assert_reset;
-
-	/* In DP-only mode, the pipe clk is still required for USB2 */
-	ret = clk_prepare_enable(qmp->pipe_clk);
-	if (ret) {
-		dev_err(qmp->dev, "pipe_clk enable failed err=%d\n", ret);
-		goto err_disable_clocks;
+	if (!keep_inputs) {
+		ret = clk_bulk_prepare_enable(qmp->num_clks, qmp->clks);
+		if (ret)
+			goto err_assert_reset;
+
+		/* In DP-only mode, the pipe clk is still required for USB2 */
+		ret = clk_prepare_enable(qmp->pipe_clk);
+		if (ret) {
+			dev_err(qmp->dev, "pipe_clk enable failed err=%d\n", ret);
+			goto err_disable_clocks;
+		}
 	}
 
 	qphy_setbits(com, QPHY_V3_DP_COM_POWER_DOWN_CTRL, SW_PWRDN);
@@ -3730,9 +3749,11 @@
 err_assert_reset:
 	reset_control_bulk_assert(cfg->num_resets, qmp->resets);
 err_disable_regulators:
-	regulator_bulk_disable(cfg->num_vregs, qmp->vregs);
+	if (!keep_inputs)
+		regulator_bulk_disable(cfg->num_vregs, qmp->vregs);
 err_decrement_count:
-	qmp->init_count--;
+	if (!keep_inputs)
+		qmp->init_count--;
 
 	return ret;
 }
@@ -3743,6 +3764,9 @@
 
 	if (!force && --qmp->init_count)
 		return 0;
+
+	if (force && qmp_combo_keep_inputs_on_reconfigure(qmp))
+		return reset_control_bulk_assert(cfg->num_resets, qmp->resets);
 
 	reset_control_bulk_assert(cfg->num_resets, qmp->resets);
 
@@ -3879,15 +3903,10 @@
 			PHY_INIT_COMPLETE_TIMEOUT);
 	if (ret) {
 		dev_err(qmp->dev, "phy initialization timed-out\n");
-		goto err_disable_pipe_clk;
+		return ret;
 	}
 
 	return 0;
-
-err_disable_pipe_clk:
-	clk_disable_unprepare(qmp->pipe_clk);
-
-	return ret;
 }
 
 static int qmp_combo_usb_power_off(struct phy *phy)
@@ -4397,35 +4416,57 @@
 {
 	struct qmp_combo *qmp = typec_switch_get_drvdata(sw);
 	const struct qmp_phy_cfg *cfg = qmp->cfg;
-
-	if (orientation == qmp->orientation || orientation == TYPEC_ORIENTATION_NONE)
-		return 0;
+	enum typec_orientation old_orientation;
+	int ret = 0;
 
 	mutex_lock(&qmp->phy_mutex);
+
+	if ((orientation == qmp->orientation && !qmp->typec_reconfigure_failed) ||
+	    orientation == TYPEC_ORIENTATION_NONE)
+		goto out_unlock;
+
+	if (qmp->typec_reconfigure_failed && qmp->dp_powered_on) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	old_orientation = qmp->orientation;
 	qmp->orientation = orientation;
 
 	if (qmp->init_count) {
 		if (qmp->usb_init_count)
 			qmp_combo_usb_power_off(qmp->usb_phy);
-		qmp_combo_com_exit(qmp, true);
-
-		qmp_combo_com_init(qmp, true);
-		if (qmp->usb_init_count)
-			qmp_combo_usb_power_on(qmp->usb_phy);
+		ret = qmp_combo_com_exit(qmp, true);
+		if (ret)
+			goto out_restore;
+
+		ret = qmp_combo_com_init(qmp, true);
+		if (ret)
+			goto out_restore;
+		if (qmp->usb_init_count) {
+			ret = qmp_combo_usb_power_on(qmp->usb_phy);
+			if (ret)
+				goto out_restore;
+		}
 		if (qmp->dp_init_count)
 			cfg->dp_aux_init(qmp);
 	}
+out_restore:
+	if (ret)
+		qmp->orientation = old_orientation;
+	qmp->typec_reconfigure_failed = !!ret;
+out_unlock:
 	mutex_unlock(&qmp->phy_mutex);
 
-	return 0;
+	return ret;
 }
 
 static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_state *state)
 {
 	struct qmp_combo *qmp = typec_mux_get_drvdata(mux);
 	const struct qmp_phy_cfg *cfg = qmp->cfg;
-	enum qmpphy_mode new_mode;
+	enum qmpphy_mode new_mode, old_mode;
 	unsigned int svid;
+	int ret = 0;
 
 	guard(mutex)(&qmp->phy_mutex);
 
@@ -4456,7 +4497,10 @@
 		new_mode = QMPPHY_MODE_USB3_ONLY;
 	}
 
-	if (new_mode == qmp->qmpphy_mode) {
+	if (qmp->typec_reconfigure_failed && qmp->dp_powered_on)
+		return -EBUSY;
+
+	if (new_mode == qmp->qmpphy_mode && !qmp->typec_reconfigure_failed) {
 		dev_dbg(qmp->dev, "typec_mux_set: same qmpphy mode, bail out\n");
 		return 0;
 	}
@@ -4469,6 +4513,7 @@
 	dev_dbg(qmp->dev, "typec_mux_set: switching from qmpphy mode %d to %d\n",
 		qmp->qmpphy_mode, new_mode);
 
+	old_mode = qmp->qmpphy_mode;
 	qmp->qmpphy_mode = new_mode;
 
 	if (qmp->init_count) {
@@ -4478,10 +4523,14 @@
 		if (qmp->dp_init_count)
 			writel(DP_PHY_PD_CTL_PSR_PWRDN, qmp->dp_dp_phy + QSERDES_DP_PHY_PD_CTL);
 
-		qmp_combo_com_exit(qmp, true);
+		ret = qmp_combo_com_exit(qmp, true);
+		if (ret)
+			goto out_restore;
 
 		/* Now everything's powered down, power up the right PHYs */
-		qmp_combo_com_init(qmp, true);
+		ret = qmp_combo_com_init(qmp, true);
+		if (ret)
+			goto out_restore;
 
 		if (new_mode == QMPPHY_MODE_DP_ONLY) {
 			if (qmp->usb_init_count)
@@ -4489,7 +4538,9 @@
 		}
 
 		if (new_mode == QMPPHY_MODE_USB3DP || new_mode == QMPPHY_MODE_USB3_ONLY) {
-			qmp_combo_usb_power_on(qmp->usb_phy);
+			ret = qmp_combo_usb_power_on(qmp->usb_phy);
+			if (ret)
+				goto out_restore;
 			if (!qmp->usb_init_count)
 				qmp->usb_init_count++;
 		}
@@ -4500,7 +4551,11 @@
 		}
 	}
 
-	return 0;
+out_restore:
+	if (ret)
+		qmp->qmpphy_mode = old_mode;
+	qmp->typec_reconfigure_failed = !!ret;
+	return ret;
 }
 
 static void qmp_combo_typec_switch_unregister(void *data)
